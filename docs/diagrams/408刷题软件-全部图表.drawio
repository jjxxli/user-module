        <mxCell id="svc" value="AiService&lt;br&gt;取题 → 组装 Prompt&lt;br&gt;→ 调模型 → 落库" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F4FF;strokeColor=#8A6FD1;fontColor=#3B2F66;fontSize=12;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="500" y="420" width="180" height="76" as="geometry" /></mxCell>
