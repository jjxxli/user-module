        <mxCell id="a8" value="记录调用 / 用量" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6A4FBF;endArrow=block;endFill=1;fontColor=#4B3B80;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Microsoft YaHei;" edge="1" parent="1" source="svc" target="t2"><mxGeometry relative="1" as="geometry" /></mxCell>
